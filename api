------------------------------------------------------------
-- RESET
------------------------------------------------------------

ENV.resetbhopapi =
    function()

        ----------------------------------------------------
        -- STYLE
        ----------------------------------------------------

        local style =
            refreshStyle()

        if style then

            local baseline =
                captureStyleBaseline(
                    style
                )

            if type(
                baseline.mv
            ) == "number"
            then

                rawset(
                    style,
                    "mv",
                    baseline.mv
                )
            end

            if typeof(
                baseline.gravity
            ) == "Vector3"
            then

                local gm =
                    API.GM

                rawset(
                    style,
                    "gravity",
                    baseline.gravity
                )

                if gm
                and type(
                    gm.SetGravity
                ) == "function"
                then

                    pcall(
                        gm.SetGravity,
                        gm,
                        baseline.gravity
                    )
                end
            end
        end

        ----------------------------------------------------
        -- CONSTANTS
        ----------------------------------------------------

        for _, target in ipairs(
            API.ConstantTargets
                .Walkspeed
        ) do

            pcall(
                setconstant,
                target.fn,
                target.index,
                target.original
            )
        end

        for _, target in ipairs(
            API.ConstantTargets
                .Friction
        ) do

            pcall(
                setconstant,
                target.fn,
                target.index,
                target.original
            )
        end

        return true
    end

