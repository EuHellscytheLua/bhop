------------------------------------------------------------
-- STATE
------------------------------------------------------------

local API = {
    GM = nil,
    Style = nil,

    StyleBaselines = setmetatable(
        {},
        {
            __mode = "k"
        }
    ),

    ConstantTargets = {
        Walkspeed = {},
        Friction = {},
    },

    OriginalConstants = {},

    Ready = false,
}

------------------------------------------------------------
-- HELPERS
------------------------------------------------------------

local function safe(fn, ...)
    if type(fn) ~= "function" then
        return false
    end

    return pcall(
        fn,
        ...
    )
end

local function getObjects()
    local ok, objects =
        pcall(
            getgc,
            true
        )

    if not ok then
        ok, objects =
            pcall(getgc)
    end

    if ok
    and type(objects) == "table"
    then
        return objects
    end

    return {}
end

------------------------------------------------------------
-- FIND ACTIVE GAMEMECHANICS
------------------------------------------------------------

local function scoreGM(object)

    if type(object) ~= "table" then
        return -1
    end

    local style =
        rawget(
            object,
            "StyleInfo"
        )

    local simulation =
        rawget(
            object,
            "Simulation"
        )

    local controls =
        rawget(
            object,
            "GameControls"
        )

    if type(style) ~= "table"
    or type(simulation) ~= "table"
    or type(controls) ~= "table"
    then
        return -1
    end

    local score = 30

    if type(
        rawget(
            simulation,
            "Phys"
        )
    ) == "table"
    then
        score += 20
    end

    if type(
        rawget(
            simulation,
            "Camera"
        )
    ) == "table"
    then
        score += 10
    end

    if typeof(
        rawget(
            object,
            "Velocity"
        )
    ) == "Vector3"
    then
        score += 15
    end

    if type(
        rawget(
            object,
            "Zones"
        )
    ) == "table"
    then
        score += 5
    end

    return score
end

local function findGameMechanics()

    local best
    local bestScore = -1

    for _, object in pairs(
        getObjects()
    ) do

        if type(object) == "table" then

            local score =
                scoreGM(object)

            if score > bestScore then
                bestScore = score
                best = object
            end
        end
    end

    API.GM = best

    if best then
        API.Style =
            rawget(
                best,
                "StyleInfo"
            )
    else
        API.Style = nil
    end

    return best
end

------------------------------------------------------------
-- STYLE BASELINE
------------------------------------------------------------

local function captureStyleBaseline(style)

    if type(style) ~= "table" then
        return nil
    end

    local existing =
        API.StyleBaselines[
            style
        ]

    if existing then
        return existing
    end

    local baseline = {
        mv =
            rawget(
                style,
                "mv"
            ),

        gravity =
            rawget(
                style,
                "gravity"
            ),
    }

    API.StyleBaselines[
        style
    ] = baseline

    return baseline
end

local function refreshStyle()

    if type(API.GM) ~= "table" then
        findGameMechanics()
    end

    if type(API.GM) ~= "table" then
        return nil
    end

    local style =
        rawget(
            API.GM,
            "StyleInfo"
        )

    if type(style) == "table" then

        API.Style = style

        captureStyleBaseline(
            style
        )

        return style
    end

    return nil
end

------------------------------------------------------------
-- LOCATE CURRENT CONSTANT TARGETS
------------------------------------------------------------

local function hasConstant(
    constants,
    wanted
)
    for _, value in pairs(constants) do
        if value == wanted then
            return true
        end
    end

    return false
end

local function hasString(
    constants,
    wanted
)
    for _, value in pairs(constants) do
        if value == wanted then
            return true
        end
    end

    return false
end

local function scanConstants()

    API.ConstantTargets.Walkspeed = {}
    API.ConstantTargets.Friction = {}

    for _, fn in pairs(
        getObjects()
    ) do

        if type(fn) == "function" then

            local okInfo, info =
                safe(
                    getinfo,
                    fn
                )

            local okConstants, constants =
                safe(
                    getconstants,
                    fn
                )

            if okInfo
            and okConstants
            and type(constants) == "table"
            then

                local source =
                    tostring(
                        info.source
                        or ""
                    )

                ------------------------------------------------
                -- Current code now lives under GameMechanics.
                ------------------------------------------------

                if source:find(
                    "GameMechanics",
                    1,
                    true
                )
                then

                    ------------------------------------------------
                    -- WALK SPEED TARGET
                    --
                    -- Old API modified 18.
                    -- Current OnPrepare still contains 18.
                    ------------------------------------------------

                    if hasConstant(
                        constants,
                        18
                    )
                    and (
                        hasString(
                            constants,
                            "WalkSplitCount"
                        )
                        or hasString(
                            constants,
                            "AllowStrafe"
                        )
                    )
                    then

                        for index, value
                            in pairs(constants)
                        do
                            if value == 18 then

                                table.insert(
                                    API.ConstantTargets
                                        .Walkspeed,
                                    {
                                        fn = fn,
                                        index = index,
                                        original = 18,
                                    }
                                )

                            end
                        end
                    end

                    ------------------------------------------------
                    -- FRICTION TARGET
                    ------------------------------------------------

                    if hasConstant(
                        constants,
                        90
                    )
                    and hasString(
                        constants,
                        "Friction"
                    )
                    then

                        for index, value
                            in pairs(constants)
                        do
                            if value == 90 then

                                table.insert(
                                    API.ConstantTargets
                                        .Friction,
                                    {
                                        fn = fn,
                                        index = index,
                                        original = 90,
                                    }
                                )

                            end
                        end
                    end

                end
            end
        end
    end
end

