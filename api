------------------------------------------------------------
-- SETGAINS
------------------------------------------------------------

ENV.setgains =
    function(multiplier)

        multiplier =
            tonumber(multiplier)
            or 1

        local style =
            refreshStyle()

        if not style then
            return false,
                "StyleInfo unavailable"
        end

        local baseline =
            captureStyleBaseline(
                style
            )

        if type(
            baseline.mv
        ) ~= "number"
        then
            return false,
                "Active style has no mv"
        end

        local value =
            baseline.mv
            * multiplier

        rawset(
            style,
            "mv",
            value
        )

        return true,
            value
    end

------------------------------------------------------------
-- SETGRAVITY
------------------------------------------------------------

ENV.setgravity =
    function(multiplier)

        multiplier =
            tonumber(multiplier)
            or 1

        local gm =
            API.GM
            or findGameMechanics()

        local style =
            refreshStyle()

        if not gm
        or not style
        then
            return false,
                "GameMechanics unavailable"
        end

        local baseline =
            captureStyleBaseline(
                style
            )

        local gravity =
            baseline.gravity

        if typeof(gravity) ~=
            "Vector3"
        then
            return false,
                "Gravity baseline unavailable"
        end

        local newGravity =
            gravity
            * multiplier

        rawset(
            style,
            "gravity",
            newGravity
        )

        ----------------------------------------------------
        -- Preferred current implementation
        ----------------------------------------------------

        local setter

        pcall(function()
            setter = gm.SetGravity
        end)

        if type(setter) ==
            "function"
        then

            local ok, err =
                pcall(
                    setter,
                    gm,
                    newGravity
                )

            if ok then
                return true,
                    newGravity
            end

            warn(
                "[BHOP API] SetGravity method failed:",
                err
            )
        end

        ----------------------------------------------------
        -- Fallback
        ----------------------------------------------------

        local simulation =
            rawget(
                gm,
                "Simulation"
            )

        local phys =
            type(simulation) ==
                "table"
            and rawget(
                simulation,
                "Phys"
            )

        if type(phys) ~= "table" then
            return false,
                "Physics object unavailable"
        end

        rawset(
            phys,
            "Gravity",
            newGravity
        )

        ----------------------------------------------------
        -- Mirror current SetGravity math
        ----------------------------------------------------

        local jumpTime =
            rawget(
                gm,
                "JumpTime"
            )

        if type(jumpTime) ==
            "number"
        then

            local y =
                newGravity.Y

            local jumpVelocity =
                -jumpTime
                * y
                / 2

            rawset(
                gm,
                "JumpVelocity",
                jumpVelocity
            )

            rawset(
                gm,
                "jv2",
                (
                    jumpVelocity
                    + y / 50
                )
                ^
                2
            )
        end

        return true,
            newGravity
    end

------------------------------------------------------------
-- SETWALKSPEED
------------------------------------------------------------

ENV.setwalkspeed =
    function(value)

        value =
            tonumber(value)

        if not value then
            value = 18
        end

        if #API.ConstantTargets
            .Walkspeed == 0
        then

            scanConstants()
        end

        if #API.ConstantTargets
            .Walkspeed == 0
        then

            return false,
                "Current walk-speed constant not found"
        end

        local changed = 0

        for _, target in ipairs(
            API.ConstantTargets
                .Walkspeed
        ) do

            local ok =
                pcall(
                    setconstant,
                    target.fn,
                    target.index,
                    value
                )

            if ok then
                changed += 1
            end

        end

        return changed > 0,
            changed
    end

------------------------------------------------------------
-- SETFRICTION
------------------------------------------------------------

ENV.setfriction =
    function(multiplier)

        multiplier =
            tonumber(multiplier)
            or 1

        if #API.ConstantTargets
            .Friction == 0
        then

            scanConstants()
        end

        if #API.ConstantTargets
            .Friction == 0
        then

            return false,
                "Current friction constant not found"
        end

        local value =
            90
            * multiplier

        local changed = 0

        for _, target in ipairs(
            API.ConstantTargets
                .Friction
        ) do

            local ok =
                pcall(
                    setconstant,
                    target.fn,
                    target.index,
                    value
                )

            if ok then
                changed += 1
            end
        end

        return changed > 0,
            changed
    end

